# Application
NODE_ENV=development
PORT=8080

# ArangoDB
ARANGO_URL=http://localhost:8529
ARANGO_DB=perper
ARANGO_USER=root
ARANGO_PASSWORD=changeme

# Security
JWT_SECRET=superlongrandomsecretkeythatshouldbereplacedwithsecureone
JWT_REFRESH_SECRET=anotherlongrandomsecretforrefreshtoken
CSRF_SECRET=anothersecretforcrsftokens
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Stripe
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_PUBLISHABLE_KEY=pk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx

# PayPal
PAYPAL_CLIENT_ID=xxx
PAYPAL_CLIENT_SECRET=xxx
PAYPAL_MODE=sandbox

# URLs
PUBLIC_BASE_URL=http://localhost:8080
FRONTEND_URL=http://localhost:5173

# Email
EMAIL_FROM=noreply@perper.digital
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASS=secret
SMTP_SECURE=false

# Admin Security
ADMIN_IP_ALLOWLIST=127.0.0.1,::1

# Bank Transfer Details
BANK_IBAN=DE00 0000 0000 0000 0000 00
BANK_BIC=ABCDEFGH
BANK_BENEFICIARY=Digital Perper d.o.o.

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
